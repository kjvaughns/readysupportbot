# ==========================================================================
# ReadySupport environment configuration
#
# Copy to `.env` for local development. In production set these as Railway
# service variables — never commit a filled-in copy of this file.
# ==========================================================================

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_BOT_TOKEN=
# Application (client) ID from the General Information tab
DISCORD_CLIENT_ID=
# The guild slash commands are registered to. Also seeds approved_guilds.
DISCORD_GUILD_ID=
# The single channel where free-form natural language requests are accepted.
# Leave blank to disable natural language entirely (slash commands still work).
DISCORD_NL_CHANNEL_ID=

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Service role key. Bypasses RLS — treat as a root credential.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket holding workflow evidence screenshots.
SUPABASE_EVIDENCE_BUCKET=automation-evidence

# --- OpenAI ----------------------------------------------------------------
# Used ONLY to classify requests and extract structured fields.
# Readymode credentials, cookies and tokens are never sent to this API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Browserbase -----------------------------------------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Persistent context id. Holds the Readymode cookies / local storage between
# runs so the bot does not have to log in on every job. Create one with:
#   npm run discover -- --create-context
BROWSERBASE_CONTEXT_ID=

# --- Readymode -------------------------------------------------------------
# Full URL of the Readymode admin login page for your instance.
READYMODE_LOGIN_URL=
READYMODE_ADMIN_USERNAME=
READYMODE_ADMIN_PASSWORD=

# --- Crypto ----------------------------------------------------------------
# 32 bytes, base64 or hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Behaviour -------------------------------------------------------------
# dry_run  : navigate, match and validate, but stop before any submitting
#            click. Reports what it *would* have done. Default.
# live     : actually submit changes.
READYSUPPORT_MODE=dry_run

# live : drive a real browser through Readymode.
# mock : use the in-memory fixture directory (local dev and tests only).
READYMODE_DRIVER=live

# Per-action kill switches. Even in live mode an action stays disabled until
# its selectors are verified and its flag is turned on.
ENABLE_CREATE_ACCOUNT=false
ENABLE_CLEAR_LICENSE=false
ENABLE_RESET_PASSWORD=false
ENABLE_DEACTIVATE_ACCOUNT=false

# Path to the verified selector overlay produced by `npm run discover`.
READYMODE_SELECTOR_OVERLAY=config/readymode-selectors.json

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# HTTP port for the /health endpoint used by the Railway healthcheck.
PORT=3000
# Minutes an approval stays valid before it expires.
APPROVAL_TTL_MINUTES=10
# Milliseconds a single browser workflow may run before it is aborted.
WORKFLOW_TIMEOUT_MS=120000
