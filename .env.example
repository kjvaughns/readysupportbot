# ---------------------------------------------------------------------------
# ReadySupport backend configuration
#
# Nothing in this file is required for the process to boot. Missing values put
# the service into setup mode: /health stays 200, /ready reports exactly which
# dependencies are unconfigured, and the affected features stay disabled.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
# Railway injects PORT. Locally this defaults to 8080.
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Public base URL of this backend (used for OAuth redirects).
PUBLIC_BASE_URL=https://readysupport-backend.up.railway.app

# Comma-separated list of allowed browser origins for the frontend.
# Required in production — CORS is never left open.
FRONTEND_URL=https://readysupport.app

# Every browser workflow simulates instead of writing while this is true.
# Turn it off only for a connection that has been verified end to end.
DRY_RUN=true

# --- Encryption ------------------------------------------------------------
# 32 bytes, hex (64 chars) or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=
# Service role key. Backend only. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Anonymous key, used only to verify frontend user access tokens.
SUPABASE_ANON_KEY=
# Optional: JWT secret for local token verification.
SUPABASE_JWT_SECRET=

# --- Discord ---------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=

# --- OpenAI ----------------------------------------------------------------
# Used only to translate natural language into a validated action object.
# Credentials and page content are never sent to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Browserbase -----------------------------------------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional persistent context id reused across sessions.
BROWSERBASE_CONTEXT_ID=

# --- Readymode ------------------------------------------------------------
# Per-organization credentials are submitted through the frontend and stored
# encrypted. These optional values are a fallback for single-tenant installs.
READYMODE_BASE_URL=
READYMODE_USERNAME=
READYMODE_PASSWORD=

# --- Limits ----------------------------------------------------------------
# Approval window in seconds (default 600 = ten minutes).
APPROVAL_TTL_SECONDS=600
# Maximum accepted request body size in bytes.
MAX_REQUEST_BYTES=131072
# API rate limit: requests per window, per key.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Maximum accounts a single bulk create request may make.
MAX_BULK_ACCOUNTS=25
