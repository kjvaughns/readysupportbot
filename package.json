{
  "name": "readysupport-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ReadySupport \u2014 Discord bot and backend for approved administrative automation inside Readymode.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "register:commands": "tsx src/discord/registerCommands.ts",
    "selectors:apply": "tsx scripts/applySelectors.ts",
    "selectors:check": "tsx scripts/applySelectors.ts --check",
    "knowledge:seed": "tsx scripts/syncKnowledge.ts --seed-only",
    "knowledge:sync": "tsx scripts/syncKnowledge.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.6.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@supabase/supabase-js": "^2.47.10",
    "cheerio": "^1.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "playwright-core": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
